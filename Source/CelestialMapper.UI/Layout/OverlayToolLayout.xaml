<local:PlatformUserControl
    x:Class="CelestialMapper.UI.OverlayToolLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CelestialMapper.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CelestialMapper.ViewModel;assembly=CelestialMapper.ViewModel"
    x:Name="mainLayout"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <DockPanel>
        <Button
            Width="32"
            Height="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding OverlayToolData.ExitOverlayCommand}"
            DockPanel.Dock="Top"
            ToolTip="Back">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Text="←" />
        </Button>

        <local:FactoryView DoNotInitializeViewModel="False" FeatureName="{Binding OverlayToolData.OverlayTool}" />
    </DockPanel>
</local:PlatformUserControl>