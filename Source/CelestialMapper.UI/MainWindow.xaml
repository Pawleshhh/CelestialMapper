<Window
    x:Class="CelestialMapper.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CelestialMapper.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CelestialMapper.ViewModel;assembly=CelestialMapper.ViewModel"
    Title="{Binding Name}"
    Width="1280"
    Height="920"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel,
                                     IsDesignTimeCreatable=False}"
    Style="{DynamicResource Style.MainWindow}"
    mc:Ignorable="d">

    <Grid>
        <local:OverlayToolLayout DataContext="{Binding .}" Visibility="{Binding OverlayToolData.IsActive, Converter={x:Static local:Converters.FalseMakesMeCollapsed}}" />
        <local:MainLayout DataContext="{Binding .}" Visibility="{Binding OverlayToolData.IsNotActive, Converter={x:Static local:Converters.FalseMakesMeCollapsed}}" />
    </Grid>
</Window>
